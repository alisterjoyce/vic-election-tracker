{
  "_schema": {
    "description": "Seat-level model estimates (MRP), one entry per district per model. Maintained by hand; seeded 30 Oct 2026 from the pollsters' own releases (the Wikipedia polling page only lists statewide seat tallies). null = not published.",
    "fields": {
      "models": "[{id, name, client, fieldwork, sample_size, published, source_url, notes}]",
      "district": "id of the district in districts.json",
      "model": "id of the model in models",
      "winner": "Predicted winner party code (ALP, LIB, NAT, LNP, GRN, ONP, IND) or null if not published",
      "runner_up": "Predicted runner-up party code or null",
      "winner_2cp": "Predicted winner's two-candidate-preferred % or null",
      "win_probability": "Predicted probability (0-100) the winner takes the seat, or null if not published"
    }
  },
