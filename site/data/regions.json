{
  "_schema": {
    "description": "Legislative Council regions (8 regions x 5 members = 40). Current MLCs and announced 2026 groups from the 30 Oct 2026 research report. Group voting tickets were abolished in 2026; 'tickets' here means each group's announced candidate order. Districts in each region come from districts.json.",
    "fields": {
      "id": "URL slug, used as the #hash on upper.html (e.g. northern-victoria)",
      "name": "Region name",
      "area": "metro | regional",
      "mlcs": "Current members: [{name, party, retiring, retiring_source, notes}]. retiring_source (optional) is set when the flag came from electiontracker.au's retirements list: {name, url, publisher, title, published, kind (official | mainstream, set by refresh.py; hand when a person checked a source the rule doesn't accept), via, added}",
      "tickets": "Groups on the 2026 ballot: [{group (ballot letter; null before the VEC publishes the 9 Nov draw, and for ungrouped candidates), party, label (the group's name as the VEC prints it), status (vec_nominated from 9 Nov; earlier endorsed | reported | withdrawn), order_official (true once the order is the VEC's ballot order; false while it is the order reported before the draw), ungrouped (true: a candidate in no group, listed after the groups), candidates: [names in order; TBC/TBD where a position was unfilled], notes}]",
      "notes": "Optional region-level notes (unnamed candidates, seats in contention)"
    }
  },
